<%-- Muestra el mensaje guardado en sesión por el servlet y luego lo elimina --%>
<c:if test="${not empty sessionScope.mensaje}">
    <div class="alerta alerta-${sessionScope.tipoMensaje}" role="status">
        <i class="fa-solid ${sessionScope.tipoMensaje eq 'exito' ? 'fa-circle-check' : 'fa-circle-exclamation'}"></i>
        <c:out value="${sessionScope.mensaje}"/>
    </div>
    <c:remove var="mensaje" scope="session"/>
    <c:remove var="tipoMensaje" scope="session"/>
</c:if>
