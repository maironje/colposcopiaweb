{
  "info": {
    "name": "Colposcopia API - AA5-EV01 Registro e inicio de sesión",
    "description": "Servicio web de registro e inicio de sesión del Software de Gestión de Colposcopia (I.P.S. Endofertil).\nAntes de ejecutar: MySQL activo, script sql/02_usuarios_y_citas.sql aplicado y la aplicación corriendo en Tomcat.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Registro",
      "item": [
        {
          "name": "01 Registro válido (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registro"
              ]
            },
            "description": "Registra una cuenta nueva. Queda con rol Auxiliar e inactiva hasta que un administrador la active.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioNuevo}}\",\n  \"clave\": \"Clave2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera un usuario distinto en cada ejecución para que el registro siempre sea nuevo",
                  "pm.collectionVariables.set(\"usuarioNuevo\", \"aprendiz\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Mensaje: Usuario registrado correctamente. La cuenta quedará habilitada cuando un administrador la active.\", function () { pm.expect(pm.response.json().mensaje).to.eql(\"Usuario registrado correctamente. La cuenta quedará habilitada cuando un administrador la active.\"); });",
                  "pm.test(\"La cuenta queda inactiva y con rol Auxiliar\", function () {",
                  "    const d = pm.response.json().datos;",
                  "    pm.expect(d.activo).to.eql(false);",
                  "    pm.expect(d.rol).to.eql(\"Auxiliar\");",
                  "});",
                  "pm.test(\"No devuelve la contraseña\", function () { pm.expect(pm.response.text()).to.not.include(\"Clave2026\"); });"
                ]
              }
            }
          ]
        },
        {
