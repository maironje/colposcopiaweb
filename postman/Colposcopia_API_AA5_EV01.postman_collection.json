          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Mensaje: Autenticación satisfactoria\", function () { pm.expect(pm.response.json().mensaje).to.eql(\"Autenticación satisfactoria\"); });",
                  "pm.test(\"Devuelve el usuario y su rol\", function () {",
                  "    pm.expect(pm.response.json().datos).to.have.property(\"rol\");",
                  "});"
                ]
              }
            }
