                  "pm.test(\"Mensaje: Error en el registro\", function () { pm.expect(pm.response.json().mensaje).to.eql(\"Error en el registro\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Registro con datos inválidos (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registro"
              ]
            },
            "description": "Usuario de 3 caracteres y contraseña débil.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"ana\",\n  \"clave\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Mensaje: Error en el registro\", function () { pm.expect(pm.response.json().mensaje).to.eql(\"Error en el registro\"); });",
                  "pm.test(\"Explica cada error\", function () { pm.expect(pm.response.json().errores.length).to.be.above(1); });"
                ]
              }
            }
          ]
        }
      ]
    },
