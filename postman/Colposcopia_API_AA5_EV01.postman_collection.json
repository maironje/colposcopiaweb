            "description": "Usa una cuenta activa. Cambie usuarioPrueba y clavePrueba en las variables de la colección.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"clave\": \"{{clavePrueba}}\"\n}",
